# Copie para .env e preencha conforme o ambiente (local, CI, staging, prod).
# Não commite o arquivo .env.

# Base URL única (opcional; sobrescreve api e ui se BASE_URL_* não estiverem definidas)
# BASE_URL=https://minha-api.com

# Base URL por tipo de teste
# BASE_URL_API=https://api.exemplo.com
# BASE_URL_UI=https://app.exemplo.com

# Autenticação (para uso futuro em fixtures)
# AUTH_TOKEN=seu-token

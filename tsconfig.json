{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["tests/**/*.ts", "playwright.config.ts", "lib/**/*.ts", "fixtures/**/*.ts", "test-data/**/*.ts", "test-data/**/*.json"],
  "exclude": ["node_modules"]
}
